# ==================== 应用配置 ====================
APP_NAME=MindCanvas Backend
APP_VERSION=1.0.0
DEBUG=False

# ==================== 服务器配置 ====================
HOST=0.0.0.0
PORT=8000

# ==================== 数据库配置 ====================
DATABASE_URL=postgresql://mindcanvas:your_secure_password@db:5432/mindcanvas

# ==================== Redis 配置 ====================
REDIS_URL=redis://redis:6379/0

# ==================== 加密密钥配置 ====================
# 加密密钥（必须设置，使用：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"）
ENCRYPTION_SECRET_KEY=your_generated_secret_key_here

# ==================== JWT 配置 ====================
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ==================== 日志配置 ====================
LOG_LEVEL=INFO

# ==================== 图片存储配置 ====================
IMAGE_STORAGE_PATH=/app/storage/images
# 本地开发环境: http://localhost:8000/images
# 生产环境: https://mindcanvas.escapemobius.cc/images
IMAGE_BASE_URL=http://localhost:8000/images

# ==================== 任务清理配置 ====================
TASK_CLEANUP_INTERVAL=3600
TASK_RETENTION_HOURS=24
IMAGE_RETENTION_DAYS=7

# ==================== API 速率限制 ====================
RATE_LIMIT_PER_MINUTE=60

# ==================== 内容安全审核 ====================
ENABLE_STRICT_AUDIT=False

# ==================== 管理员配置 ====================
# 管理员密钥（用于邮箱配额注入接口认证）
ADMIN_SECRET_KEY=your-admin-secret-key-change-in-production

# ==================== Laozhang API 配置 ====================
# Laozhang API Key（后端统一管理，用于给用户分配免费额度）
LAOZHANG_API_KEY=sk-YOUR_LAOZHANG_API_KEY